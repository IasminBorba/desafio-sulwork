# Copie para .env e ajuste os valores. Nunca commite o .env.

# Banco
DB_NAME=eventos
DB_USER=eventos
DB_PASSWORD=eventos
DB_PORT=5433

# Backend (na máquina local, contra o Postgres do compose)
DB_URL=jdbc:postgresql://localhost:5433/eventos
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRATION=8h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

# Frontend publicado pelo compose (nginx)
FRONTEND_PORT=80

